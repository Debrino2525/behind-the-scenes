{
  "expo": {
    "name": "Behind The Scenes",
    "slug": "behind-the-scenes-dating-app",
    "scheme": "btsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b10",
    "splash": {
      "backgroundColor": "#090b10",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.behindthescenes.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.behindthescenes.app",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090b10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b846f31e-3423-458b-9249-3e113c00a41f"
      }
    },
    "owner": "behind-the-scenes",
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Behind The Scenes requires camera access to perform the 5-second anti-catfish selfie check."
        }
      ],
      "expo-audio",
      "expo-asset"
    ]
  }
}
